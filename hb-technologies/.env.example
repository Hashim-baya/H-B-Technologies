# Frontend public config
# Production canonical origin (required in production)
NEXT_PUBLIC_SITE_URL=https://www.vizia.co.ke

# Optional canonical host override used by proxy redirects
VIZIA_DOMAIN_NAME=www.vizia.co.ke

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (used by Next.js route handlers to call the Express API)
# Never expose service role keys or JWT secrets with NEXT_PUBLIC_
API_URL=https://your-api.onrender.com

# Optional public API URL for client-side fetches (prefer same-origin /api proxy)
# NEXT_PUBLIC_API_URL=

# Optional analytics
# NEXT_PUBLIC_GA_ID=

# ── Search Engine Verification ────────────────────────────────────────────────
# Obtain these codes from the respective webmaster consoles.
# Both are optional — omit to skip injecting the <meta> tag.
#
# Google Search Console:
#   1. Go to https://search.google.com/search-console/
#   2. Add property → URL prefix → https://www.vizia.co.ke
#   3. Choose "HTML tag" verification method → copy the content="..." value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=REPLACE_WITH_GOOGLE_CODE
#
# Bing Webmaster Tools:
#   1. Go to https://www.bing.com/webmasters/
#   2. Add site → choose "Meta tag" verification → copy the content="..." value
# NEXT_PUBLIC_BING_SITE_VERIFICATION=REPLACE_WITH_BING_CODE
